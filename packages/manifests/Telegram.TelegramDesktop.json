{
  "schemaVersion": "1.0.0",
  "packageId": "Telegram.TelegramDesktop",
  "profile": "admin",
  "purpose": "Мессенджер",
  "license": "GPL-3.0 (клиент)",
  "source": "winget",
  "installArgs": [
    "--id",
    "Telegram.TelegramDesktop",
    "--exact",
    "--version",
    "<VERSION>",
    "--accept-source-agreements",
    "--accept-package-agreements",
    "--silent",
    "--disable-interactivity",
    "--source",
    "winget"
  ],
  "versionPolicy": "pinned-by-lock",
  "lockFile": "packages/lock/Packages.lock.json",
  "requiresNetwork": true,
  "rules": [
    "AR-601",
    "AR-602",
    "AR-603",
    "AR-604"
  ],
  "notes": [
    "SC_TOOLKIT_PRESERVED: Telegram",
    "Версия берётся из lock-файла: без неё установка блокируется (AR-602)."
  ]
}
