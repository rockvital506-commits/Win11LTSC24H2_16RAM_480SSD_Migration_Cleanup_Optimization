{
  "schemaVersion": "1.0.0",
  "packageId": "Git.Git",
  "profile": "base",
  "purpose": "Система контроля версий, ядро рабочего контура",
  "license": "GPL-2.0",
  "source": "winget",
  "installArgs": [
    "--id",
    "Git.Git",
    "--exact",
    "--version",
    "<VERSION>",
    "--accept-source-agreements",
    "--accept-package-agreements",
    "--silent",
    "--disable-interactivity",
    "--source",
    "winget"
  ],
  "versionPolicy": "pinned-by-lock",
  "lockFile": "packages/lock/Packages.lock.json",
  "requiresNetwork": true,
  "rules": [
    "AR-601",
    "AR-602",
    "AR-603",
    "AR-604"
  ],
  "notes": [
    "Устанавливается машино-Linux (git-for-windows)",
    "Версия берётся из lock-файла: без неё установка блокируется (AR-602)."
  ]
}
