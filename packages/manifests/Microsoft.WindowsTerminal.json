{
  "schemaVersion": "1.0.0",
  "packageId": "Microsoft.WindowsTerminal",
  "profile": "base",
  "purpose": "Терминал (профили PowerShell/WSL)",
  "license": "MIT",
  "source": "winget",
  "installArgs": [
    "--id",
    "Microsoft.WindowsTerminal",
    "--exact",
    "--version",
    "<VERSION>",
    "--accept-source-agreements",
    "--accept-package-agreements",
    "--silent",
    "--disable-interactivity",
    "--source",
    "winget"
  ],
  "versionPolicy": "pinned-by-lock",
  "lockFile": "packages/lock/Packages.lock.json",
  "requiresNetwork": true,
  "rules": [
    "AR-601",
    "AR-602",
    "AR-603",
    "AR-604"
  ],
  "notes": [
    "Требуется для работы с WSL2",
    "Версия берётся из lock-файла: без неё установка блокируется (AR-602)."
  ]
}
