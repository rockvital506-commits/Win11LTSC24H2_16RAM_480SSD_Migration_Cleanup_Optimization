{
  "schemaVersion": "1.0.0",
  "packageId": "MobaXterm.MobaXterm",
  "profile": "devops",
  "purpose": "SSH/терминальный клиент",
  "license": "Проприетарная (бесплатная редакция)",
  "source": "winget",
  "installArgs": [
    "--id",
    "MobaXterm.MobaXterm",
    "--exact",
    "--version",
    "<VERSION>",
    "--accept-source-agreements",
    "--accept-package-agreements",
    "--silent",
    "--disable-interactivity",
    "--source",
    "winget"
  ],
  "versionPolicy": "pinned-by-lock",
  "lockFile": "packages/lock/Packages.lock.json",
  "requiresNetwork": true,
  "rules": [
    "AR-601",
    "AR-602",
    "AR-603",
    "AR-604"
  ],
  "notes": [
    "SC_TOOLKIT_PRESERVED: MobaXterm",
    "Версия берётся из lock-файла: без неё установка блокируется (AR-602)."
  ]
}
